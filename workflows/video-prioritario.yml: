name: Video Prioritario — Composición FFmpeg

on:
  workflow_dispatch:
    inputs:
      job_id:
        description: "ID del job en video_prioritario_jobs"
        required: true
        type: string

env:
  SUPABASE_URL: https://sdfwredxmyawvolxuifp.supabase.co
  R2_ENDPOINT: ${{ secrets.R2_ENDPOINT }}
  R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
  R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
  R2_BUCKET: ${{ secrets.R2_BUCKET }}
  SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}

jobs:
  componer:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Instalar FFmpeg y AWS CLI
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq ffmpeg awscli

      - name: Configurar credenciales R2 (S3-compatible)
        run: |
          aws configure set aws_access_key_id "$R2_ACCESS_KEY_ID"
          aws configure set aws_secret_access_key "$R2_SECRET_ACCESS_KEY"
          aws configure set default.region auto

      - name: Leer job desde Supabase
        id: job
        run: |
          RESP=$(curl -sf "$SUPABASE_URL/rest/v1/video_prioritario_jobs?id=eq.${{ inputs.job_id }}&select=*" \
            -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY")
          echo "$RESP" | jq -c '.[0]' > job.json
          echo "playlist_fondo_id=$(jq -r '.playlist_fondo_id' job.json)" >> "$GITHUB_OUTPUT"
          echo "texto_overlay=$(jq -r '.texto_overlay // ""' job.json)" >> "$GITHUB_OUTPUT"
          jq -r '.archivos_filmados[]' job.json > filmados.txt
          cat filmados.txt

      - name: Leer playlist_items de la playlist de fondo (en orden)
        run: |
          RESP=$(curl -sf "$SUPABASE_URL/rest/v1/playlist_items?playlist_id=eq.${{ steps.job.outputs.playlist_fondo_id }}&activo=eq.true&select=orden,media:media_id(url_storage)&order=orden" \
            -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY")
          echo "$RESP" | jq -r '.[].media.url_storage' > fondo_urls.txt
          cat fondo_urls.txt

      - name: Descargar clips filmados y fondo
        run: |
          mkdir -p in/filmados in/fondo
          i=0
          while read -r url; do
            [ -z "$url" ] && continue
            i=$((i+1))
            curl -sfL "$url" -o "in/filmados/clip_$(printf %03d $i).mp4"
          done < filmados.txt

          i=0
          while read -r url; do
            [ -z "$url" ] && continue
            i=$((i+1))
            curl -sfL "$url" -o "in/fondo/bg_$(printf %03d $i).mp4"
          done < fondo_urls.txt

      - name: Concatenar clips filmados (si hay varios)
        run: |
          cd in/filmados
          for f in clip_*.mp4; do echo "file '$f'"; done > list.txt
          ffmpeg -y -f concat -safe 0 -i list.txt -c copy ../filmado_final.mp4 \
            || ffmpeg -y -f concat -safe 0 -i list.txt -c:v libx264 -c:a aac ../filmado_final.mp4
          cd ../..

      - name: Concatenar fondo de publicidad (en el orden de la playlist)
        run: |
          cd in/fondo
          for f in bg_*.mp4; do echo "file '$f'"; done > list.txt
          ffmpeg -y -f concat -safe 0 -i list.txt -c:v libx264 -c:a aac -r 30 ../fondo_final.mp4
          cd ../..

      - name: Componer video final (filmado full-screen + PIP publicidad 30% esq. inf. derecha, loop de fondo hasta cubrir duración)
        run: |
          DUR_FILMADO=$(ffprobe -v error -show_entries format=duration -of csv=p=0 in/filmado_final.mp4)
          TEXTO='${{ steps.job.outputs.texto_overlay }}'

          FILTER="[1:v]scale=iw*0.30:-2[pip];[0:v][pip]overlay=W-w-24:H-h-24:shortest=1[base]"
          if [ -n "$TEXTO" ] && [ "$TEXTO" != "null" ]; then
            FILTER="${FILTER}[base];[base]drawtext=text='${TEXTO}':fontsize=28:fontcolor=white:borderw=2:bordercolor=black:x=24:y=H-th-24[outv]"
          else
            FILTER="${FILTER};[base]null[outv]"
          fi

          ffmpeg -y \
            -i in/filmado_final.mp4 \
            -stream_loop -1 -i in/fondo_final.mp4 \
            -filter_complex "$FILTER" \
            -map "[outv]" -map 0:a? \
            -t "$DUR_FILMADO" \
            -c:v libx264 -preset veryfast -crf 20 -c:a aac \
            out_compuesto.mp4

      - name: Subir resultado a R2 (misma carpeta que los videos filmados)
        id: upload
        run: |
          NOMBRE="COMPUESTO_$(date +%Y-%m-%d_%H%M%S).mp4"
          aws s3 cp out_compuesto.mp4 "s3://$R2_BUCKET/$NOMBRE" --endpoint-url "$R2_ENDPOINT"
          URL="https://$(echo $R2_ENDPOINT | sed 's|https://||')/$R2_BUCKET/$NOMBRE"
          echo "video_final_url=$URL" >> "$GITHUB_OUTPUT"

      - name: Marcar job como listo
        if: success()
        run: |
          curl -sf -X PATCH "$SUPABASE_URL/rest/v1/video_prioritario_jobs?id=eq.${{ inputs.job_id }}" \
            -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Content-Type: application/json" \
            -d "{\"estado\":\"listo\",\"video_final_url\":\"${{ steps.upload.outputs.video_final_url }}\"}"

      - name: Marcar job como error (si algo falló antes)
        if: failure()
        run: |
          curl -sf -X PATCH "$SUPABASE_URL/rest/v1/video_prioritario_jobs?id=eq.${{ inputs.job_id }}" \
            -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Content-Type: application/json" \
            -d "{\"estado\":\"error\",\"error_detail\":\"Falló el workflow de GitHub Actions — ver logs del run.\"}"
